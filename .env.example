# Nếu muốn sử dụng Supabase Cloud làm backend chính, điền thông tin sau:
# Lấy từ Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Nếu để trống 2 biến trên, ứng dụng sẽ tự động kích hoạt Real Local SQL Database Engine (SQLite persistent storage)
# đảm bảo ứng dụng chạy mượt mà 100% không bao giờ bị lỗi kết nối hoặc trang trắng!
