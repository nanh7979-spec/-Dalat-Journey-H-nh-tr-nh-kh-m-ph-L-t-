# ==============================================================
# HÀNH TRÌNH KHÁM PHÁ ĐÀ LẠT (DALAT JOURNEY)
# CẤU HÌNH BIẾN MÔI TRƯỜNG / ENVIRONMENT VARIABLES
# ==============================================================

# 1. Cấu hình Cơ sở dữ liệu PostgreSQL (Host nội bộ)
# Điền chuỗi kết nối PostgreSQL của bạn theo định dạng:
# DATABASE_URL=postgresql://<username>:<password>@<internal-host>:<port>/<database-name>
# Ví dụ: DATABASE_URL=postgresql://postgres:secret123@192.168.1.100:5432/dalat_journey
DATABASE_URL=

# 2. Cấu hình Supabase Cloud (Tùy chọn)
# Lấy từ Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ghi chú:
# - Nếu DATABASE_URL được thiết lập, ứng dụng sẽ ưu tiên kết nối PostgreSQL trên host nội bộ.
# - Nếu để trống, ứng dụng sẽ tự động dùng Real Local SQL Database Engine (SQLite persistent storage).

